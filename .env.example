# Node.js 22+; lokal .env.local erstellen. Niemals echte Secrets committen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Für den gehosteten Checkout nicht erforderlich; für spätere Stripe.js-Integration reserviert.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
# Beispielsyntax: WAKPU <bestellungen@deine-verifizierte-domain.ch>
RESEND_FROM_EMAIL=
FULFILLMENT_PROVIDER=mock
ADMIN_EMAIL=
SUPPORT_EMAIL=
# Jeweils mindestens 32 zufällige Zeichen; separat generieren: openssl rand -hex 32
CRON_SECRET=
ORDER_ACCESS_SECRET=
